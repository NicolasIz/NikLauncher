 OPENJDK_TARGET_OS_ENV:=@OPENJDK_TARGET_OS_ENV@
 OPENJDK_TARGET_OS_UPPERCASE:=@OPENJDK_TARGET_OS_UPPERCASE@
 
+# Android runs a linux kernel behind a different libc, and the sources, source
+# roots and build variables it needs are the linux ones almost everywhere. The
+# alternative to this single name is an android copy of every per-OS variable
+# and every per-OS source root, each one silently skipped wherever it was
+# forgotten rather than reported. Equal to OPENJDK_TARGET_OS on every platform
+# upstream supports, so nothing outside an android build changes.
+ifeq ($(OPENJDK_TARGET_OS), android)
+  OPENJDK_TARGET_OS_VARIANT := linux
+else
+  OPENJDK_TARGET_OS_VARIANT := $(OPENJDK_TARGET_OS)
+endif
+
 OPENJDK_TARGET_CPU:=@OPENJDK_TARGET_CPU@
 OPENJDK_TARGET_CPU_ARCH:=@OPENJDK_TARGET_CPU_ARCH@
 OPENJDK_TARGET_CPU_BITS:=@OPENJDK_TARGET_CPU_BITS@
