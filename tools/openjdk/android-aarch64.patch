 const char* os::Linux::dll_path(void* lib) {
+  assert(lib != nullptr, "dll_path parameter must not be null");
+#ifdef __ANDROID__
+  // Bionic exposes no equivalent of dlinfo(RTLD_DI_LINKMAP) to applications.
+  // The result feeds diagnostics only, so an unknown path costs a less
+  // informative message rather than correctness.
+  return nullptr;
+#else
   struct link_map *lmap;
   const char* l_path = nullptr;
-  assert(lib != nullptr, "dll_path parameter must not be null");
 
   int res_dli = ::dlinfo(lib, RTLD_DI_LINKMAP, &lmap);
   if (res_dli == 0) {
     l_path = lmap->l_name;
   }
   return l_path;
+#endif
 }
 
