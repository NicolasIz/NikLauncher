<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Minecraft needs a real GPU; the launcher is not useful without one. -->
    <uses-feature android:glEsVersion="0x00030002" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!--
        allowNativeHeapPointerTagging is off because HotSpot cannot live with
        it. From Android 11 malloc returns pointers carrying a tag in the top
        byte, and free rejects one that comes back without it - the device
        reported "Pointer tag for 0x6f34df0f00 was truncated" and the VM died
        there. HotSpot stores and reconstructs pointers in ways that do not
        preserve that byte: compressed oops, mark words, the card table. This
        is the escape hatch Android documents for exactly that, and it costs
        only a heap hardening feature that a JVM was never going to satisfy.
    -->
    <application
        android:name=".NikLauncherApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:allowNativeHeapPointerTagging="false"
        android:theme="@style/Theme.NikLauncher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode"
            android:label="@string/app_name"
            android:theme="@style/Theme.NikLauncher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Its own process, because the JNI Invocation API gives no way to tear
            a VM down and build another: a second session needs a fresh process,
            and a crash inside the game would otherwise take the launcher too.
        -->
        <activity
            android:name=".game.GameActivity"
            android:exported="false"
            android:process=":runtime"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode|navigation"
            android:screenOrientation="sensorLandscape"
            android:launchMode="singleTask"
            android:theme="@style/Theme.NikLauncher" />
        <!--
            A session log is the only account of a failed launch, and internal
            storage cannot be browsed from the phone - so the launcher hands
            the file to a share sheet rather than printing a path nobody can
            open. Not exported: only URIs the launcher grants can be read.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
